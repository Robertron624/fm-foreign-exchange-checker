---
import LiveMarkets from '../../components/LiveMarkets';
---

<header>
  <div class="top-header">
    <a href="/">
      <img
        class="header-logo"
        src="/images/logo.svg"
        alt="Foreign Exchange Checker Logo"
      />
    </a>
    <p class="header-feats">55 · CURRENCIES EOD · ECB</p>
  </div>
  <LiveMarkets client:load />
</header>

<style lang="scss">
  header {
    text-align: center;

    .top-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 1rem;

      .header-logo {
        max-width: 6.697rem;
        height: auto;
        display: block;

        @include tablet {
          max-width: 8.6875rem;
        }
      }

      .header-feats {
        margin: 0;
        font-size: 0.625rem;
        color: var(--color-neutral-200);

        @include tablet {
          font-size: 0.875rem;
        }
      }
    }

  }
</style>
