---
import Header from "./components/Header.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>
		Foreign Exchange Checker
	</title>
  </head>
  <body>
    <Header />
    <slot />
  </body>
</html>

<style lang="scss">
  @font-face {
    font-family: "JetBrains Mono";
    font-style: normal;
    font-weight: 100 800;
    font-display: swap;
    src: url("/fonts/jetbrains-mono/jetbrains-mono-variable.ttf")
      format("truetype");
  }

  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  button {
	color: inherit;
    border: none;
    padding: 0.5rem 1rem;
    cursor: pointer;
  }

  ol,
  ul {
	list-style: none;
	padding: 0;
	margin: 0;
  }

  p {
	margin: 0;
  }

  img {
	display: block;
	max-width: 100%;
	height: auto;
  }

  body {
    font-family: "JetBrains Mono", monospace;
	background-color: var(--color-neutral-700);
	color: var(--color-neutral-50);
  }

  :global(:root) {
    --color-neutral-900: #{$color-neutral-900};
    --color-neutral-700: #{$color-neutral-700};
    --color-neutral-600: #{$color-neutral-600};
    --color-neutral-500: #{$color-neutral-500};
    --color-neutral-400: #{$color-neutral-400};
    --color-neutral-300: #{$color-neutral-300};
    --color-neutral-200: #{$color-neutral-200};
    --color-neutral-100: #{$color-neutral-100};
    --color-neutral-50: #{$color-neutral-50};
    --color-lime-500: #{$color-lime-500};
    --color-lime-800: #{$color-lime-800};
    --color-green-500: #{$color-green-500};
    --color-red-500: #{$color-red-500};
  }
</style>
